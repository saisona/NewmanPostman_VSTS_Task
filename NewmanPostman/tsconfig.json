{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodeNext",
    "moduleDetection": "auto",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist"
  },
  "exclude": [ "node_modules" ]
}

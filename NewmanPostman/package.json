{
  "name": "task",
  "version": "1.0.1",
  "description": "package.json for task lib",
  "scripts": {
    "package": "npm run clean  && npm run compile  && tfx extension create  --rev-version",
    "gallery-publish": "tfx extension publish",
    "gallery-publish-rev": "tfx extension publish --rev-version",
    "clean": "rimraf ./*.vsix",
    "compile": "npx tsc -p .",
    "install-task-lib": "npm install --save-dev",
    "pretest": "npx tsc -p .",
    "test": "npx mocha Tests//TestSuite.js"
  },
  "dependencies": {
    "azure-pipelines-task-lib": "^4.13.0",
    "reflect-metadata": "^0.2.2",
    "is-url": "^1.2.4"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.14.10",
    "@types/normalize-package-data": "^2.4.4",
    "@types/q": "^1.5.8",
    "sync-request": "^6.1.0",
    "typescript": "^5.5.3",
    "mocha": "^11.7.0"
  }
}
